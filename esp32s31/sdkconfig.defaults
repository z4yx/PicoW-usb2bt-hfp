# ESP32-S31-WROOM-3-N16R16V: 16 MB flash, 16 MB PSRAM
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y

# 4 MB application partition (BT stack + UAC + bridge)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth Classic + HFP AG. ESP32-S31 supports the HCI SCO data path only.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_AG_ENABLE=y
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BT_HFP_WBS_ENABLE=y
CONFIG_BT_HFP_USE_EXTERNAL_CODEC=n

# USB UAC device: 48 kHz, 2ch speaker, 1ch mic, 16-bit
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=1
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_SPK_INTERVAL_MS=10
CONFIG_UAC_MIC_INTERVAL_MS=10
CONFIG_UAC_SUPPORT_MACOS=n
CONFIG_UAC_TUSB_VID=0x303A
CONFIG_UAC_TUSB_PID=0x8000
CONFIG_UAC_TUSB_MANUFACTURER="PicoW USB2BT"
CONFIG_UAC_TUSB_PRODUCT="PicoW USB2BT HFP"

# HFP example defaults
CONFIG_EXAMPLE_LOCAL_DEVICE_NAME="Pico USB2BT HFP"

# Console on the USB-Serial/JTAG debug port (UART0 not wired during bring-up)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# ESP32-S31 BT controller: Classic BR/EDR only (HFP)
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1

# HCI trace for SCO/eSCO debugging
CONFIG_BT_LOG_HCI_TRACE_LEVEL_DEBUG=y
